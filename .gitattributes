# These run inside a Linux container. A Windows checkout with core.autocrlf=true
# rewrites them to CRLF, which makes the shebang `/usr/bin/env bash\r` — the
# image then builds fine and dies on start with a "bad interpreter" no error
# message explains. Only affects building on Windows; the published image is
# built on Linux runners.
*.sh text eol=lf
entrypoint.sh text eol=lf
bin/doctor text eol=lf
