#!/usr/bin/env bash
# Why can't I connect?
#
#   docker exec <box> doctor
#
# Checks, in the order a request travels: the daemon, then DNS, then the
# outside world, then the tailnet, then TLS. Every failure this template was
# built around shows up in exactly one of these lines.
set -uo pipefail

PORT="${KITTERM_PORT:-3418}"
SOCK=/run/tailscale/tailscaled.sock
FAIL=0

ok()   { printf "  \033[32mok\033[0m    %s\n" "$*"; }
bad()  { printf "  \033[31mFAIL\033[0m  %s\n" "$*"; FAIL=1; }
note() { printf "        %s\n" "$*"; }
ts()   { tailscale --socket="$SOCK" "$@" 2>/dev/null; }

echo "kitterm"
if curl -fsS -m 5 -o /dev/null "http://127.0.0.1:$PORT/api/health" 2>/dev/null; then
  ok "daemon answering on 127.0.0.1:$PORT"
else
  bad "daemon not answering on 127.0.0.1:$PORT"
  note "check: su vscode -c 'kitterm status'  and  ~/.kitterm/server.log"
fi

SESSIONS=$(curl -fsS -m 5 "http://127.0.0.1:$PORT/api/sessions" 2>/dev/null \
           | grep -o '"id"' | wc -l | tr -d ' ')
note "${SESSIONS:-0} session(s) open"

if su vscode -c 'grep -q kitterm_precmd ~/.bashrc' 2>/dev/null; then
  ok "shell integration installed (commands and exit codes are indexed)"
else
  bad "no shell integration in ~/.bashrc"
  note "without it /api/sessions/<id>/commands stays empty forever"
fi

# A repo was asked for and never arrived. The box no longer dies over this, so
# this is where you find out — the startup log may be far behind by now.
WORKSPACE="${WORKSPACE_DIR:-${STATE_DIR:+$STATE_DIR/workspace}}"
WORKSPACE="${WORKSPACE:-/workspace}"
if [ -n "${WORKSPACE_REPO:-}" ]; then
  # The clone lands in $WORKSPACE/<name>. A checkout at the root is a box from
  # before that change, and is still valid.
  NAME=${WORKSPACE_REPO%/}; NAME=${NAME%.git}; NAME=${NAME##*/}
  if [ -d "$WORKSPACE/$NAME/.git" ] || [ -d "$WORKSPACE/.git" ]; then
    ok "workspace holds a clone of $WORKSPACE_REPO"
  else
    bad "WORKSPACE_REPO is set but $WORKSPACE/$NAME has no checkout"
    note "the clone failed at startup; see: docker logs <box> | grep -i clone"
    note "an ssh host alias from your laptop does not resolve in here — use the"
    note "https:// URL, with GH_TOKEN if the repo is private"
  fi
fi

echo
echo "network"
if getent hosts api.anthropic.com >/dev/null 2>&1; then
  ok "DNS resolves"
else
  bad "DNS is broken"
  note "resolv.conf: $(grep ^nameserver /etc/resolv.conf | tr '\n' ' ')"
  note "100.100.100.100 means MagicDNS was accepted; it is unreachable under"
  note "userspace networking. Restart with --accept-dns=false."
fi

CODE=$(curl -s -o /dev/null -w '%{http_code}' -m 12 https://api.anthropic.com/v1/messages 2>/dev/null)
if [ "$CODE" = "405" ] || [ "$CODE" = "401" ] || [ "$CODE" = "400" ]; then
  ok "api.anthropic.com reachable (HTTP $CODE)"
elif [ "$CODE" = "000" ] || [ -z "$CODE" ]; then
  bad "api.anthropic.com unreachable — agents will time out"
else
  ok "api.anthropic.com reachable (HTTP $CODE)"
fi

echo
echo "tailscale"
if [ ! -S "$SOCK" ]; then
  note "not running — this box is in local mode (published port only)"
else
  STATE=$(ts status --json | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{
      try{const j=JSON.parse(s);process.stdout.write([
        (j.BackendState||"-"),
        (j.Self?.DNSName||"-").replace(/\.$/,""),
        ((j.Self?.TailscaleIPs||[])[0]||"-")].join(" "))}catch(e){}})' 2>/dev/null)
  BACKEND=$(printf '%s' "$STATE" | cut -d' ' -f1)
  FQDN=$(printf '%s' "$STATE" | cut -d' ' -f2)
  TSIP=$(printf '%s' "$STATE" | cut -d' ' -f3)
  if [ "$BACKEND" = "Running" ]; then
    ok "joined as ${FQDN:-<no name>}"
  else
    bad "backend state: ${BACKEND:-unknown}"
    note "if it says NeedsMachineAuth, approve it: https://login.tailscale.com/admin/machines"
  fi

  SERVE=$(ts serve status)
  if [ -n "$SERVE" ]; then
    ok "serve configured"
    echo "$SERVE" | sed 's/^/        /'
  else
    bad "nothing is being served — the URL will refuse connections"
  fi

  # The one failure with no visible symptom: serve is configured, the port
  # answers, and the TLS handshake dies because no certificate can be issued.
  if echo "$SERVE" | grep -q '^https://'; then
    # Ask the question directly rather than read the log for scary words. Two
    # normal lines look like failures: "Funnel is not enabled" is how tailscaled
    # announces it chose the dns-01 challenge, and "tls-cert-pending: error" is
    # the pending state during issuance, cleared by a later "ok".
    #
    # --resolve, because this box declines MagicDNS, so the tailnet name does
    # not resolve from in here. SNI still carries the name, so the handshake is
    # the same one a phone performs.
    CODE=000
    if [ -n "$TSIP" ] && [ "$TSIP" != "-" ]; then
      # No `|| echo 000` here. curl already prints 000 on a failed handshake and
      # then exits non-zero, so the fallback appended a second 000 and the test
      # below saw "000000", which is not "000", and passed a total failure.
      CODE=$(curl -sS -m 25 -o /dev/null -w '%{http_code}' \
             --resolve "$FQDN:443:$TSIP" "https://$FQDN/" 2>/dev/null)
      [ -n "$CODE" ] || CODE=000
    fi
    case "$CODE" in
      2??|3??|4??|5??)
      # 403 is a pass here: TLS completed and kitterm asked for a token.
        ok "TLS completes on https://$FQDN (HTTP $CODE)" ;;
      *)
        bad "TLS did not complete for $FQDN"
      if grep -q rateLimited /var/log/tailscaled.log 2>/dev/null; then
        note "Let's Encrypt rate-limited this name: 5 failed authorizations per hour"
        note "$(grep rateLimited /var/log/tailscaled.log | tail -1 | cut -c1-150)"
        note "wait an hour, or change TS_HOSTNAME for a fresh budget"
      elif grep -qE 'status: invalid|OrderError' /var/log/tailscaled.log 2>/dev/null; then
        note "the dns-01 challenge failed; check https://status.tailscale.com"
        note "$(grep -E 'status: invalid|OrderError' /var/log/tailscaled.log | tail -1 | cut -c1-150)"
      else
        note "the certificate is fetched on the first handshake, so give it a few"
        note "seconds after start, then run doctor again"
        note "if it persists, enable HTTPS Certificates:"
        note "https://login.tailscale.com/admin/dns"
      fi ;;
    esac
  fi
fi

echo
echo "agents"
for a in claude codex grok opencode; do
  if command -v "$a" >/dev/null 2>&1; then
    ok "$a $("$a" --version 2>/dev/null | head -1)"
  fi
done

echo
if [ "$FAIL" -eq 0 ]; then
  echo "All checks passed."
else
  echo "Some checks failed — see the notes above."
fi
exit "$FAIL"
