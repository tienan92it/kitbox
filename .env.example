# Copy to .env and fill in. Nothing here is baked into the image.

# --- remote access ------------------------------------------------------------
# From https://login.tailscale.com/admin/settings/keys
# Leave empty to run in local mode and reach the box on a published port.
TS_AUTHKEY=
TS_HOSTNAME=kitbox

# Set to 1 if your tailnet does not have HTTPS Certificates enabled. The tailnet
# is encrypted either way, but a plain-HTTP origin is not a secure context, so
# your phone cannot install the terminal as an app.
TS_SERVE_HTTP=

# --- workspace ----------------------------------------------------------------
# Cloned into <workspace>/<repo-name> on first start. Use an ssh:// URL with
# a mounted key, or https:// with GH_TOKEN.
WORKSPACE_REPO=
GIT_USER_NAME=
GIT_USER_EMAIL=
GH_TOKEN=

# --- agents -------------------------------------------------------------------
# Build-time: which CLIs the image contains. claude is always included.
#   AGENTS=claude,codex,grok,opencode
AGENTS=claude

# Runtime credentials. Claude Code can also log in interactively in the browser
# terminal, which is usually easier than managing a key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROK_API_KEY=

# --- security -----------------------------------------------------------------
# POST /api/sessions/<id>/input lets anything holding a token type into a shell
# instead of only watching one. On by default — that is how you drive an agent
# from a phone. Set to 0 and a leaked token can watch but not type; the browser
# terminal keeps working either way.
AGENT_CONTROL=1

# --- misc ---------------------------------------------------------------------
TZ=UTC
